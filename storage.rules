rules_version = '2';

// Uploads: o navegador envia o arquivo direto para o Storage, em uma pasta
// temporária própria do usuário autenticado (evita o limite de tamanho das
// funções serverless). O servidor move o arquivo para o destino definitivo e
// registra o documento. Leituras só acontecem via servidor (URL assinada).
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.role in ['owner', 'manager', 'professional', 'staff']
        && request.resource.size < 25 * 1024 * 1024;
      allow read: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
